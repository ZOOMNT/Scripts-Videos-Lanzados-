      --============================================================

      local function getClosestDuck()
         local closest = nil
         local closestDistance = math.huge

         local viewport = camera.ViewportSize

         local center = Vector2.new(
         viewport.X / 2,
         viewport.Y / 2
         )

         for _, hitbox in ipairs(getDuckHitboxes()) do
            if hitbox:IsDescendantOf(workspace) then

               local screenPosition, visible =
               camera:WorldToViewportPoint(hitbox.Position)

               if visible and screenPosition.Z > 0 then

                  local screenPoint = Vector2.new(
                  screenPosition.X,
                  screenPosition.Y
                  )

                  local distance =
                  (screenPoint - center).Magnitude

                  if distance <= fovRadius
                  and distance < closestDistance then

                     closestDistance = distance
                     closest = hitbox

                  end
               end
            end
         end

         return closest
      end

