      --============================================================

      local function getDuckHitboxes()
         local result = {}

         local ume = workspace:FindFirstChild("Ume")

         if not ume then
            return result
         end

         for _, object in ipairs(ume:GetChildren()) do
            if object.Name:match("^DuckController_Client_%d+$") then
               local hitbox = object:FindFirstChild("Hitbox", true)

               if hitbox and hitbox:IsA("BasePart") then
                  table.insert(result, hitbox)
               end
            end
         end

         return result
      end

      --============================================================
