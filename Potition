copyButton.Position = UDim2.new(0, 6, 0, 86)
copyButton.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
copyButton.BorderSizePixel = 0
copyButton.Text = "Copiar CFrame"
copyButton.TextColor3 = Color3.fromRGB(220, 220, 225)
copyButton.TextSize = 13
copyButton.Font = Enum.Font.GothamBold
copyButton.AutoButtonColor = false
copyButton.Parent = frame

Instance.new("UICorner", copyButton).CornerRadius = UDim.new(0, 7)

local dragging = false
local dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	frame.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

dragBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

dragBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

copyButton.MouseButton1Click:Connect(function()
	local root = getRoot()
	if not root then
		coordsBox.Text = "No hay personaje"
		return
	end

	local p = root.Position
	local text = string.format("CFrame.new(%.3f, %.3f, %.3f)", p.X, p.Y, p.Z)

	coordsBox.Text = text
	coordsBox:CaptureFocus()
	coordsBox.CursorPosition = #text + 1
	coordsBox.SelectionStart = 1

	copyButton.BackgroundColor3 = Color3.fromRGB(30, 140, 70)
	copyButton.Text = "Copiado"
	task.delay(0.7, function()
		if copyButton.Parent then
			copyButton.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
			copyButton.Text = "Copiar CFrame"
		end
	end)
end)

RunService.RenderStepped:Connect(function()
	local root = getRoot()
	if root then
		local p = root.Position
		liveLabel.Text = string.format("X: %.2f  Y: %.2f  Z: %.2f", p.X, p.Y, p.Z)
	else
		liveLabel.Text = "X: --  Y: --  Z: --"
	end
end)
